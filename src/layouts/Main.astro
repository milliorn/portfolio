---
import Footer from "../components/Footer/Footer.astro";
import Navigation from "../components/Navigation/Navigation.astro";
import { site } from "../config";
import "../styles/global.css";
import type { MainProps } from "./types";

// props
const props = Astro.props as MainProps;
const { title = `${site.owner} Portfolio` } = props;

// vars
const head = {
  links: {
    icon: "/nintendo2.svg",
    sitemap: "/sitemap-index.xml",
  },
  meta: {
    content: "My Professional Portfolio, Scott Milliorn",
    name: "description",
  },
};
---

<html lang="en">
  <head>
    <link rel="icon" type="image/svg+xml" href={head.links.icon} />
    <link
      rel="preload"
      href="/fonts/Inter-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Inter-Italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/Inter-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="sitemap" href={head.links.sitemap} />
    <meta charset="utf-8" />
    <meta name="generator" content={Astro.generator} />
    <meta name="viewport" content="width=device-width" />
    <meta name={head.meta.name} content={head.meta.content} />
    <title>{title}</title>

    <!-- This class will let CSS know that JS is available — and we can trust it to control visibility. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <script is:inline type="module">
      const root = document.documentElement;
      const media = window.matchMedia("(prefers-color-scheme: dark)");

      // The legacy "theme" key was auto-seeded on every visit regardless of
      // whether the user ever made a choice, so it carries no signal that
      // distinguishes an explicit choice from an accidental default. Drop
      // it rather than migrating it, so returning visitors resume following
      // system preference instead of being locked to a stale guess.
      localStorage.removeItem("theme");
      const userTheme = localStorage.getItem("userTheme");

      // Apply the user's explicit choice, falling back to system preference
      const isDark = userTheme ? userTheme === "dark" : media.matches;
      root.classList.toggle("dark", isDark);

      // Keep following system preference until the user explicitly chooses a theme
      media.addEventListener("change", (e) => {
        if (!localStorage.getItem("userTheme")) {
          root.classList.toggle("dark", e.matches);
        }
      });
    </script>
  </head>
  <body>
    <!-- <ThemeToggler /> -->
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
